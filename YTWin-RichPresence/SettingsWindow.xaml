<ui:FluentWindow
    x:Class="YTWin_RichPresence.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:YTWin_RichPresence"
    xmlns:properties="clr-namespace:YTWin_RichPresence.Properties"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d"
    Title="{x:Static properties:Localisation.Settings_Title}"
    Icon="/Resources/YTWinRP.ico"
    ExtendsContentIntoTitleBar="True" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
    MinWidth="665" Width="720" Height="880">
    <Grid TextElement.FontSize="14">
        <ui:TitleBar/>
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="80" Padding="10" Margin="0 5 0 10">
                <DockPanel Margin="10 5 0 0">
                    <Image HorizontalAlignment="Left" Margin="0 0 0 0" Source="/Resources/YTWinRP-128x.png"/>
                    <StackPanel Orientation="Vertical" Grid.Column="1" Margin="16 0 0 0">
                        <TextBlock
                            FontWeight="Bold" FontSize="20" Margin="0 0 0 3"
                            Text="{x:Static local:Constants.ApplicationStylisedName}"/>
                        <TextBlock
                            VerticalAlignment="Bottom" FontWeight="Light" FontSize="17"
                            Text="{x:Static local:Constants.ProgramVersion}"/>
                    </StackPanel>
                    <Button
                        Grid.Column="2" Width="35" Margin="0 10 10 0" VerticalAlignment="Bottom"
                        Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" HorizontalAlignment="Right"
                        Click="GitHubButton_Click">
                        <Image x:Name="Image_GitHub" Source="/Resources/GitHub_Invertocat_Black.png"/>
                    </Button>
                </DockPanel>
            </Border>
            <ui:NavigationView DockPanel.Dock="Left" IsBackButtonVisible="Collapsed" IsFooterSeparatorVisible="False" IsTopSeparatorVisible="False" OpenPaneLength="130" PaneDisplayMode="Left" IsPaneOpen="True">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem
                        x:Name="NavItemGeneral"
                        Content="{x:Static properties:Localisation.Settings_General_SectionTitle}"
                        Icon="{ui:SymbolIcon Home24}"
                        Click="NavItemGeneral_Click"/>
                    <ui:NavigationViewItem
                        x:Name="NavItemDetection"
                        Content="{x:Static properties:Localisation.Settings_Detection_SectionTitleShort}"
                        Icon="{ui:SymbolIcon Eye24}"
                        Click="NavItemDetection_Click"/>
                    <ui:NavigationViewItem
                        x:Name="NavItemDiscord"
                        Content="{x:Static properties:Localisation.Settings_Discord_SectionTitleShort}"
                        Icon="{ui:SymbolIcon XboxController48}"
                        Click="NavItemDiscord_Click"/>
                    <ui:NavigationViewItem
                        x:Name="NavItemScrobbling"
                        Content="{x:Static properties:Localisation.Settings_Scrobbling_SectionTitleShort}"
                        Icon="{ui:SymbolIcon Headphones20}"
                        Click="NavItemScrobbling_Click"/>
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.ContentOverlay>
                    <Border>
                        <ScrollViewer x:Name="ScrollViewerSettings" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ScrollViewerTop" Orientation="Vertical" Margin="20 0 25 20">

                                <!-- ============================ General ============================ -->
                                <TextBlock
                                    x:Name="SectionTitleGeneral"
                                    FontSize="18" FontWeight="Bold" Padding="0 15 0 5" Margin="0 0 0 7" VerticalAlignment="Top"
                                    Text="{x:Static properties:Localisation.Settings_General_SectionTitle}"/>

                                <CheckBox
                                    x:Name="CheckBox_RunOnStartup"
                                    IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=RunOnStartup, Mode=TwoWay}"
                                    Click="CheckBox_RunOnStartup_Click"
                                    Content="{x:Static properties:Localisation.Settings_General_RunOnWindowsStartup}"/>

                                <CheckBox
                                    x:Name="CheckBox_CheckForUpdatesOnStartup"
                                    IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=CheckForUpdatesOnStartup, Mode=TwoWay}"
                                    Click="Setting_Click"
                                    Content="{x:Static properties:Localisation.Settings_General_UpdateOnStartup}"/>

                                <StackPanel Orientation="Horizontal" Margin="10 10 0 2">
                                    <TextBlock
                                        x:Name="TextBlock_LanguageLabel"
                                        VerticalAlignment="Center"
                                        Text="Language"/>
                                    <ComboBox
                                        x:Name="ComboBox_Language"
                                        Width="245"
                                        Margin="10 0 0 0"
                                        SelectionChanged="ComboBox_Language_SelectionChanged">
                                        <ComboBoxItem x:Name="ComboBoxItem_LanguageSystem" Tag="" Content="System default (System default)"/>
                                        <ComboBoxItem x:Name="ComboBoxItem_LanguageEnglish" Tag="en" Content="English (English)"/>
                                        <ComboBoxItem x:Name="ComboBoxItem_LanguageGerman" Tag="de" Content="German (Deutsch)"/>
                                        <ComboBoxItem x:Name="ComboBoxItem_LanguageTurkish" Tag="tr" Content="Turkce (Türkçe)"/>
                                        <ComboBoxItem x:Name="ComboBoxItem_LanguageKorean" Tag="ko" Content="Korean (한국어)"/>
                                        <ComboBoxItem x:Name="ComboBoxItem_LanguageJapanese" Tag="ja" Content="Japanese (日本語)"/>
                                        <ComboBoxItem x:Name="ComboBoxItem_LanguageRussian" Tag="ru" Content="Russian (Русский)"/>
                                        <ComboBoxItem x:Name="ComboBoxItem_LanguageSpanish" Tag="es" Content="Spanish - Spain (Español de España)"/>
                                        <ComboBoxItem x:Name="ComboBoxItem_LanguageLatam" Tag="es-MX" Content="Latin American Spanish (Español de Latinoamérica)"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock
                                    x:Name="TextBlock_LanguageDescription"
                                    Margin="10 5 0 10" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                    Text="Restart the app after changing the language."/>

                                <!-- ============================ Detection ============================ -->
                                <TextBlock
                                    x:Name="SectionTitleDetection"
                                    FontSize="18" FontWeight="Bold" Padding="0 15 0 5" Margin="0 10 0 7" VerticalAlignment="Top"
                                    Text="{x:Static properties:Localisation.Settings_Detection_SectionTitle}"/>
                                <TextBlock
                                    Margin="0 0 0 10" FontSize="12" TextWrapping="Wrap"
                                    Text="{x:Static properties:Localisation.Settings_Detection_Description}"/>

                                <ui:Card Margin="0 5 0 10">
                                    <StackPanel>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Static properties:Localisation.Settings_Detection_Status_Title}"/>
                                        <TextBlock x:Name="TextBlock_PlaybackStatus" Margin="0 4 0 0" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ui:Card>

                                <CheckBox
                                    x:Name="CheckBox_ShowVideos"
                                    IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=ShowVideos, Mode=TwoWay}"
                                    Click="Setting_Click"
                                    Content="{x:Static properties:Localisation.Settings_Detection_ShowVideos}"/>
                                <CheckBox
                                    x:Name="CheckBox_ShowMusic"
                                    IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=ShowMusic, Mode=TwoWay}"
                                    Click="Setting_Click"
                                    Content="{x:Static properties:Localisation.Settings_Detection_ShowMusic}"/>
                                <CheckBox
                                    x:Name="CheckBox_DetectMusic"
                                    IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=DetectMusic, Mode=TwoWay}"
                                    Click="CheckBox_Detection_Click"
                                    Content="{x:Static properties:Localisation.Settings_Detection_DetectMusic}"/>
                                <TextBlock
                                    Margin="40 0 0 10" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                    Text="{x:Static properties:Localisation.Settings_Detection_DetectMusic_Description}"/>
                                <CheckBox
                                    x:Name="CheckBox_RequireYouTubeWindow"
                                    IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=RequireYouTubeWindow, Mode=TwoWay}"
                                    Click="CheckBox_Detection_Click"
                                    Content="{x:Static properties:Localisation.Settings_Detection_RequireWindow}"/>
                                <TextBlock
                                    Margin="40 0 0 10" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                    Text="{x:Static properties:Localisation.Settings_Detection_RequireWindow_Description}"/>

                                <!-- Detection: optional browser extension -->
                                <ui:Card Margin="0 15 0 5">
                                    <StackPanel>
                                        <DockPanel Margin="0 0 0 7">
                                            <TextBlock
                                                FontSize="16" FontWeight="SemiBold" VerticalAlignment="Top"
                                                Text="{x:Static properties:Localisation.Settings_Detection_Extension_SectionTitle}"/>
                                            <StackPanel HorizontalAlignment="Right">
                                                <ui:ToggleSwitch
                                                    x:Name="Toggle_ExtensionBridge"
                                                    IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=ExtensionBridgeEnabled, Mode=TwoWay}"
                                                    Click="Toggle_ExtensionBridge_Click"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock
                                            Margin="0 0 0 12" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                            Text="{x:Static properties:Localisation.Settings_Detection_Extension_Description}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                                            <TextBlock VerticalAlignment="Center" Text="{x:Static properties:Localisation.Settings_Detection_Extension_Port}"/>
                                            <TextBox
                                                x:Name="TextBox_ExtensionPort" Width="90" Margin="10 0 0 0" Padding="7 5 7 5" FontFamily="Cascadia Mono" MaxLength="5"
                                                IsEnabled="{Binding IsChecked, ElementName=Toggle_ExtensionBridge}"
                                                LostFocus="TextBox_ExtensionPort_LostFocus"
                                                KeyDown="TextBox_ExtensionPort_KeyDown"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TextBlock_ExtensionStatus" Margin="0 0 0 12" FontSize="12" TextWrapping="Wrap"/>
                                        <Button
                                            x:Name="Button_OpenExtensionFolder" HorizontalAlignment="Right"
                                            Content="{x:Static properties:Localisation.Settings_Detection_Extension_OpenFolder}"
                                            Click="Button_OpenExtensionFolder_Click"/>
                                    </StackPanel>
                                </ui:Card>

                                <!-- ============================ Discord RP ============================ -->
                                <TextBlock
                                    x:Name="SectionTitleDiscord"
                                    FontSize="18" FontWeight="Bold" Padding="0 15 0 5" Margin="0 10 0 7" VerticalAlignment="Top"
                                    Text="{x:Static properties:Localisation.Settings_Discord_SectionTitle}"/>

                                <CheckBox
                                    x:Name="CheckBox_EnableDiscordRP"
                                    IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=EnableDiscordRP, Mode=TwoWay}"
                                    Click="Setting_Click"
                                    Content="{x:Static properties:Localisation.Settings_Discord_EnableRP}"/>

                                <ui:Card x:Name="Card_DiscordClientId" Margin="0 10 0 10">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="16" FontWeight="SemiBold" Margin="0 0 0 7"
                                            Text="{x:Static properties:Localisation.Settings_Discord_ClientID_SectionTitle}"/>
                                        <TextBlock
                                            Margin="0 0 0 12" FontSize="12" TextWrapping="Wrap"
                                            Text="{x:Static properties:Localisation.Settings_Discord_ClientID_Description}"/>
                                        <TextBlock Text="{x:Static properties:Localisation.Settings_Discord_ClientID}"/>
                                        <TextBox
                                            x:Name="TextBox_DiscordClientID" Margin="0 7 0 10" FontFamily="Cascadia Mono" MaxLength="32"
                                            Text="{Binding Source={x:Static properties:Settings.Default}, Path=DiscordClientID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            LostFocus="TextBox_DiscordClientID_LostFocus"
                                            KeyDown="TextBox_DiscordClientID_KeyDown"/>
                                        <TextBlock Text="{x:Static properties:Localisation.Settings_Discord_ClientIDMusic}"/>
                                        <TextBox
                                            x:Name="TextBox_DiscordClientIDMusic" Margin="0 7 0 10" FontFamily="Cascadia Mono" MaxLength="32"
                                            Text="{Binding Source={x:Static properties:Settings.Default}, Path=DiscordClientIDMusic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            LostFocus="TextBox_DiscordClientID_LostFocus"
                                            KeyDown="TextBox_DiscordClientID_KeyDown"/>
                                        <StackPanel x:Name="Panel_DiscordClientIDWarning" Orientation="Horizontal" Visibility="Collapsed" Margin="0 0 0 8">
                                            <ui:FontIcon Glyph="&#xE783;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0 0 6 0"/>
                                            <TextBlock FontSize="12" Text="{x:Static properties:Localisation.Settings_Discord_ClientID_Invalid}"/>
                                        </StackPanel>
                                        <Button
                                            x:Name="Button_OpenDeveloperPortal" HorizontalAlignment="Right"
                                            Content="{x:Static properties:Localisation.Settings_Discord_OpenDeveloperPortal}"
                                            Click="Button_OpenDeveloperPortal_Click"/>
                                    </StackPanel>
                                </ui:Card>

                                <CheckBox
                                    x:Name="CheckBox_EnableRPCoverImages"
                                    IsEnabled="{Binding IsChecked, ElementName=CheckBox_EnableDiscordRP}"
                                    IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=EnableRPCoverImages, Mode=TwoWay}"
                                    Click="Setting_Click"
                                    Content="{x:Static properties:Localisation.Settings_Discord_ShowAlbumArt}"/>

                                <CheckBox
                                    x:Name="CheckBox_ShowRPAlbumTitle"
                                    IsEnabled="{Binding IsChecked, ElementName=CheckBox_EnableDiscordRP}"
                                    IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=ShowAlbumTitle, Mode=TwoWay}"
                                    Click="Setting_Click"
                                    Content="{x:Static properties:Localisation.Settings_Discord_ShowAlbumTitle}"/>

                                <CheckBox
                                    x:Name="CheckBox_ShowRPWhenPaused"
                                    IsEnabled="{Binding IsChecked, ElementName=CheckBox_EnableDiscordRP}"
                                    IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=ShowRPWhenPaused, Mode=TwoWay}"
                                    Click="Setting_Click"
                                    Content="{x:Static properties:Localisation.Settings_Discord_ShowWhenPaused}"/>

                                <CheckBox
                                    x:Name="CheckBox_ShowServiceIcon"
                                    IsEnabled="{Binding IsChecked, ElementName=CheckBox_EnableDiscordRP}"
                                    IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=ShowServiceIcon, Mode=TwoWay}"
                                    Click="Setting_Click"
                                    Content="{x:Static properties:Localisation.Settings_Discord_ShowServiceIcon}"/>
                                <TextBlock
                                    Margin="40 0 0 10" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                    Text="{x:Static properties:Localisation.Settings_Discord_ShowServiceIcon_Description}"/>

                                <StackPanel Orientation="Horizontal" Margin="10 7 0 7">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Margin="0 0 10 2"
                                        Text="{x:Static properties:Localisation.Settings_Discord_UserStatusDisplay}"/>
                                    <ComboBox
                                        x:Name="ComboBox_RPDisplayChoice"
                                        IsEnabled="{Binding IsChecked, ElementName=CheckBox_EnableDiscordRP}"
                                        SelectedIndex="{Binding Source={x:Static properties:Settings.Default}, Path=RPDisplayChoice, Mode=TwoWay}"
                                        SelectionChanged="ComboBox_RPDisplayChoice_SelectionChanged">
                                        <!-- The order of these items matters! (check the enum in YouTubeDiscordClient.cs) -->
                                        <ComboBoxItem Content="{x:Static properties:Localisation.Settings_Discord_UserStatusDisplay_Artist}"/>
                                        <ComboBoxItem Content="{x:Static properties:Localisation.Settings_Discord_UserStatusDisplay_AppName}"/>
                                        <ComboBoxItem Content="{x:Static properties:Localisation.Settings_Discord_UserStatusDisplay_SongName}"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="10 7 0 2">
                                    <TextBlock
                                        x:Name="TextBlock_DiscordClientLabel"
                                        VerticalAlignment="Center"
                                        Margin="0 0 10 2"
                                        Text="Send Rich Presence to"/>
                                    <ComboBox
                                        x:Name="ComboBox_DiscordClient"
                                        Width="245"
                                        IsEnabled="{Binding IsChecked, ElementName=CheckBox_EnableDiscordRP}"
                                        SelectionChanged="ComboBox_DiscordClient_SelectionChanged">
                                        <ComboBoxItem x:Name="ComboBoxItem_DiscordClientAuto"/>
                                        <ComboBoxItem x:Name="ComboBoxItem_DiscordClientStable"/>
                                        <ComboBoxItem x:Name="ComboBoxItem_DiscordClientPTB"/>
                                        <ComboBoxItem x:Name="ComboBoxItem_DiscordClientCanary"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock
                                    x:Name="TextBlock_DiscordClientDescription"
                                    Margin="10 5 0 10" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                    Text="Choose which Discord app receives Rich Presence when you have more than one running."/>

                                <!-- Discord RP settings: Lyrics (experimental) -->
                                <ui:Card Margin="0 15 0 5">
                                    <StackPanel>
                                        <DockPanel Margin="0 0 0 7">
                                            <TextBlock
                                                FontSize="16" FontWeight="SemiBold" VerticalAlignment="Top"
                                                IsEnabled="{Binding IsChecked, ElementName=CheckBox_EnableDiscordRP}"
                                                Text="{x:Static properties:Localisation.Settings_Discord_Lyrics_SectionTitle}"/>
                                            <StackPanel HorizontalAlignment="Right">
                                                <ui:ToggleSwitch
                                                    x:Name="CheckBox_EnableSyncLyrics"
                                                    IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=EnableSyncLyrics, Mode=TwoWay}"
                                                    Click="Setting_Click"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <TextBlock
                                            Margin="0 0 0 15" FontSize="12"  VerticalAlignment="Center" TextWrapping="Wrap"
                                            Text="{x:Static properties:Localisation.Settings_Discord_Lyrics_EnableLyrics}"/>

                                        <CheckBox
                                            x:Name="CheckBox_ExtendLyricsLine"
                                            IsEnabled="{Binding IsChecked, ElementName=CheckBox_EnableSyncLyrics}"
                                            IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=ExtendLyricsLine, Mode=TwoWay}"
                                            Click="Setting_Click"
                                            Content="{x:Static properties:Localisation.Settings_Discord_Lyrics_ShowDuringBreak}"/>
                                        <TextBlock
                                            Margin="40 0 0 10" FontSize="12"  VerticalAlignment="Center" TextWrapping="Wrap"
                                            Text="{x:Static properties:Localisation.Settings_Discord_Lyrics_ShowDuringBreak_Description}"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
                                            <Button
                                                x:Name="Button_OpenLyricCache" Margin="0 0 15 0"
                                                Content="{x:Static properties:Localisation.Settings_Discord_Lyrics_OpenCache}"
                                                Click="Button_OpenLyricCache_Click" />
                                            <Button
                                                x:Name="Button_DeleteLyricCache"
                                                Content="{x:Static properties:Localisation.Settings_Discord_Lyrics_ClearCache}"
                                                Click="Button_DeleteLyricCache_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ui:Card>

                                <!-- ============================ Scrobbling ============================ -->
                                <TextBlock
                                    x:Name="SectionTitleScrobbling"
                                    Padding="0 15 0 5" Margin="0 20 0 7" FontWeight="Bold" FontSize="18"
                                    Text="{x:Static properties:Localisation.Settings_Scrobbling_SectionTitle}"/>
                                <TextBlock
                                    Margin="0 0 0 10" FontSize="12" TextWrapping="Wrap"
                                    Text="{x:Static properties:Localisation.Settings_Scrobbling_Description}"/>

                                <CheckBox
                                    x:Name="CheckBox_ScrobbleVideos"
                                    IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=ScrobbleVideos, Mode=TwoWay}"
                                    Click="Setting_Click"
                                    Content="{x:Static properties:Localisation.Settings_Scrobbling_ScrobbleVideos}"/>

                                <CheckBox
                                    x:Name="CheckBox_CleanTitles"
                                    IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=CleanTitles, Mode=TwoWay}"
                                    Click="Setting_Click"
                                    Content="{x:Static properties:Localisation.Settings_Scrobbling_CleanTitles}"/>
                                <TextBlock
                                    Margin="40 0 0 10" FontSize="12"  VerticalAlignment="Center" TextWrapping="Wrap"
                                    Text="{x:Static properties:Localisation.Settings_Scrobbling_CleanTitles_Description}"/>

                                <CheckBox
                                    x:Name="CheckBox_LastfmScrobblePrimary"
                                    Margin="0 2 0 0"
                                    IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=LastfmScrobblePrimaryArtist, Mode=TwoWay}"
                                    Click="Setting_Click"
                                    Content="{x:Static properties:Localisation.Settings_Scrobbling_ScrobblePrimaryArtist}"/>

                                <StackPanel Orientation="Horizontal" Margin="10 10 0 5">
                                    <TextBlock
                                        VerticalAlignment="Center" Padding="0 0 0 1"
                                        Text="{x:Static properties:Localisation.Settings_Scrobbling_ScrobbleTime}"/>
                                    <TextBox
                                        x:Name="ScrobbleMaxTime" Width="60" Margin="10 0 7 2" Padding="7 5 7 5" TextWrapping="Wrap" HorizontalContentAlignment="Right"
                                        MaxLines="1" MaxLength="5"
                                        Text="{Binding Source={x:Static properties:Settings.Default}, Path=ScrobbleMaxWait}"
                                        TextChanged="ScrobbleMaxTime_TextChanged"/>
                                    <TextBlock
                                        VerticalAlignment="Center" Padding="0 0 0 1"
                                        Text="{x:Static properties:Localisation.Settings_TimeUnitSeconds}"/>
                                </StackPanel>
                                <TextBlock
                                    Margin="10 0 0 10" FontSize="12"  VerticalAlignment="Center" TextWrapping="Wrap"
                                    Text="{x:Static properties:Localisation.Settings_Scrobbling_ScrobbleTime_Description}"/>

                                <!-- Scrobbling settings: Last.FM -->
                                <ui:Card Margin="0 15 0 5">
                                    <StackPanel>
                                        <DockPanel Margin="0 0 0 10">
                                            <TextBlock
                                                FontSize="16" FontWeight="SemiBold"
                                                Text="{x:Static properties:Localisation.Settings_Scrobbling_LastFM_SectionTitle}"/>
                                            <StackPanel HorizontalAlignment="Right">
                                            <ui:ToggleSwitch
                                                x:Name="CheckBox_LastfmEnable" Margin="0 2 0 10"
                                                IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=LastfmEnable, Mode=TwoWay}"
                                                Click="Setting_Click"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{x:Static properties:Localisation.Settings_Scrobbling_LastFM_ApiKey}"/>
                                        <TextBox
                                            x:Name="LastfmAPIKey" Margin="0 7 0 10" TextWrapping="Wrap" FontFamily="Cascadia Mono"
                                            IsEnabled="{Binding IsChecked, ElementName=CheckBox_LastfmEnable}"
                                            Text="{Binding Source={x:Static properties:Settings.Default}, Path=LastfmAPIKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{x:Static properties:Localisation.Settings_Scrobbling_LastFM_ApiSecret}"/>
                                        <TextBox
                                            x:Name="LastfmSecret" Margin="0 7 0 10" TextWrapping="Wrap" FontFamily="Cascadia Mono"
                                            IsEnabled="{Binding IsChecked, ElementName=CheckBox_LastfmEnable}"
                                            Text="{Binding Source={x:Static properties:Settings.Default}, Path=LastfmSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{x:Static properties:Localisation.Settings_Scrobbling_LastFM_Username}"/>
                                        <TextBox
                                            x:Name="LastfmUsername" Margin="0 7 0 10" TextWrapping="Wrap"
                                            IsEnabled="{Binding IsChecked, ElementName=CheckBox_LastfmEnable}"
                                            Text="{Binding Source={x:Static properties:Settings.Default}, Path=LastfmUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{x:Static properties:Localisation.Settings_Scrobbling_LastFM_Password}"/>
                                        <PasswordBox
                                            x:Name="LastfmPassword"  Margin="0 7 0 10" VerticalAlignment="Center"
                                            PasswordChar="●"
                                            IsEnabled="{Binding IsChecked, ElementName=CheckBox_LastfmEnable}"/>

                                        <Button
                                            x:Name="SaveLastFMCreds" Margin="0 7 0 0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                            IsEnabled="{Binding IsChecked, ElementName=CheckBox_LastfmEnable}"
                                            Content="{x:Static properties:Localisation.Settings_Scrobbling_LastFM_SaveCredentials}"
                                            Click="SaveLastFMCreds_Click" />
                                    </StackPanel>
                                </ui:Card>

                                <!-- Scrobbling settings: ListenBrainz -->
                                <ui:Card Margin="0 15 0 5">
                                    <StackPanel>
                                        <DockPanel Margin="0 0 0 10">
                                            <TextBlock
                                                FontSize="16" FontWeight="SemiBold"
                                                Text="{x:Static properties:Localisation.Settings_Scrobbling_ListenBrainz_SectionTitle}"/>
                                            <StackPanel HorizontalAlignment="Right">
                                                <ui:ToggleSwitch
                                                    x:Name="CheckBox_ListenBrainzEnable" VerticalAlignment="Center" Margin="0 2 0 10"
                                                    IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=ListenBrainzEnable, Mode=TwoWay}"
                                                    Click="Setting_Click"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{x:Static properties:Localisation.Settings_Scrobbling_ListenBrainz_UserToken}"/>
                                        <TextBox
                                            x:Name="ListenBrainzUserToken" Margin="0 7 0 10" FontFamily="Cascadia Mono"
                                            IsEnabled="{Binding IsChecked, ElementName=CheckBox_ListenBrainzEnable}"
                                            Text="{Binding Source={x:Static properties:Settings.Default}, Path=ListenBrainzUserToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap"/>

                                        <Button x:Name="SaveListenBrainzCreds" Margin="0 7 0 0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                            IsEnabled="{Binding IsChecked, ElementName=CheckBox_ListenBrainzEnable}"
                                            Content="{x:Static properties:Localisation.Settings_Scrobbling_LastFM_SaveCredentials}"
                                            Click="SaveListenBrainzCreds_Click"/>
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </ui:NavigationView.ContentOverlay>
            </ui:NavigationView>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
